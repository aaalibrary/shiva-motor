<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sell Your Vehicle | Shiva Motors</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root { --brand-dark: #0f172a; --brand-accent: #ea580c; --bg-base: #f8fafc; --surface: #ffffff; --text-main: #1e293b; --text-muted: #64748b; --border-light: #e2e8f0; --success: #16a34a; }
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
        body { background-color: var(--bg-base); color: var(--text-main); display: flex; justify-content: center; padding: 40px 20px; }
        
        .form-container { background: var(--surface); max-width: 600px; width: 100%; padding: 40px; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border: 1px solid var(--border-light); }
        h2 { text-align: center; color: var(--brand-dark); margin-bottom: 10px; }
        .progress-bar { display: flex; gap: 10px; margin-bottom: 30px; }
        .progress-step { flex: 1; height: 6px; background: var(--border-light); border-radius: 10px; transition: 0.3s; }
        .progress-step.active { background: var(--brand-accent); }
        
        .step { display: none; animation: fadeIn 0.4s; }
        .step.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        
        .form-group { margin-bottom: 20px; }
        label { font-weight: 600; display: block; margin-bottom: 8px; }
        select, input, textarea { width: 100%; padding: 12px; border: 1px solid var(--border-light); border-radius: 8px; font-size: 1rem; }
        
        .btn-row { display: flex; justify-content: space-between; margin-top: 30px; }
        button { padding: 12px 24px; border: none; border-radius: 8px; font-weight: 700; cursor: pointer; transition: 0.2s; }
        .btn-next { background: var(--brand-accent); color: white; margin-left: auto; }
        .btn-next:disabled { background: #cbd5e1; cursor: not-allowed; }
        .btn-back { background: var(--border-light); color: var(--text-main); }
        
        .grid-options { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        .opt-card { border: 2px solid var(--border-light); padding: 20px; text-align: center; border-radius: 10px; cursor: pointer; font-weight: 600; }
        .opt-card.selected { border-color: var(--brand-accent); background: #fff7ed; color: var(--brand-accent); }
        
        .file-upload-box { border: 2px dashed var(--brand-accent); padding: 30px; text-align: center; border-radius: 12px; cursor: pointer; background: #fff7ed; margin-bottom: 15px; }
        #previewContainer { display: flex; gap: 10px; flex-wrap: wrap; }
        .img-preview { width: 80px; height: 80px; object-fit: cover; border-radius: 8px; border: 1px solid var(--border-light); }
        .photo-count { font-size: 0.85rem; color: var(--text-muted); font-weight: 600; margin-bottom: 10px; display: block; }

        .success-screen { text-align: center; display: none; }
        .check-circle { width: 80px; height: 80px; border-radius: 50%; background: var(--success); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
        .check-circle svg { fill: white; width: 40px; height: 40px; }
        @keyframes scaleIn { 0% { transform: scale(0); } 100% { transform: scale(1); } }
        
        @media (max-width: 600px) { .form-container { padding: 25px; } }
    </style>
</head>
<body>

<div class="form-container">
    <div id="formContent">
        <h2>Sell Your Vehicle</h2>
        
        <div class="progress-bar">
            <div class="progress-step active" id="pb-1"></div>
            <div class="progress-step" id="pb-2"></div>
            <div class="progress-step" id="pb-3"></div>
            <div class="progress-step" id="pb-4"></div>
        </div>

        <!-- Step 1: Category -->
        <div class="step active" id="step-1">
            <label>What are you selling?</label>
            <div class="grid-options">
                <div class="opt-card" onclick="selectCategory(this, 'Car')">Car</div>
                <div class="opt-card" onclick="selectCategory(this, 'Bike')">Bike</div>
                <div class="opt-card" onclick="selectCategory(this, 'Tractor')">Tractor</div>
                <div class="opt-card" onclick="selectCategory(this, 'JCB')">JCB</div>
                <div class="opt-card" onclick="selectCategory(this, 'Commercial')">Commercial</div>
            </div>
            <input type="hidden" id="sellCategory" value="">
            <div class="btn-row"><button class="btn-next" onclick="nextStep(1)">Next Step</button></div>
        </div>

        <!-- Step 2: Condition -->
        <div class="step" id="step-2">
            <div class="form-group">
                <label>Overall Condition</label>
                <select id="sellCondition">
                    <option value="">Select condition...</option>
                    <option value="Excellent">Excellent (Like New)</option>
                    <option value="Good">Good (Minor wear)</option>
                    <option value="Average">Average (Visible wear)</option>
                    <option value="Needs repair">Needs Repair</option>
                </select>
            </div>
            <div class="form-group">
                <label>Additional Details (Optional)</label>
                <textarea id="sellDetails" rows="4" placeholder="Mention mileage, service history, etc."></textarea>
            </div>
            <div class="btn-row">
                <button class="btn-back" onclick="prevStep(2)">Back</button>
                <button class="btn-next" onclick="nextStep(2)">Next Step</button>
            </div>
        </div>

        <!-- Step 3: Photos -->
        <div class="step" id="step-3">
            <label>Upload Vehicle Photos</label>
            <span class="photo-count" id="photoStatus">Minimum 5 photos required (Front, Back, Sides, Interior). Currently: 0</span>
            
            <label for="vehiclePhotos" class="file-upload-box">
                <span style="font-size: 24px; display: block; margin-bottom: 5px;">📸</span>
                <strong style="color: var(--brand-accent);">Click to select images</strong>
                <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 5px;">(JPEG, PNG only)</p>
            </label>
            <input type="file" id="vehiclePhotos" multiple accept="image/*" style="display: none;" onchange="handleFiles(this)">
            
            <div id="previewContainer"></div>

            <div class="btn-row">
                <button class="btn-back" onclick="prevStep(3)">Back</button>
                <button class="btn-next" id="btnNextPhoto" disabled onclick="nextStep(3)">Next Step</button>
            </div>
        </div>

        <!-- Step 4: Price & OTP Verification -->
        <div class="step" id="step-4">
            <div class="form-group">
                <label>Expected Price (₹)</label>
                <input type="number" id="sellPrice" min="1" placeholder="e.g. 250000">
            </div>

            <div style="background: #f8fafc; padding: 20px; border-radius: 12px; border: 1px solid var(--border-light); margin-top: 20px;">
                <h4 style="color: var(--brand-dark); margin-bottom: 15px;">Verify Phone Number</h4>
                
                <div id="phoneStep">
                    <div class="form-group">
                        <input type="tel" id="phoneNumber" placeholder="+91 99999 99999" value="+91">
                        <small style="color: var(--text-muted); display: block; margin-top: 5px;">Include +91 country code</small>
                    </div>
                    
                    <!-- Firebase reCAPTCHA loads here -->
                    <div id="recaptcha-container" style="margin-bottom: 15px;"></div>
                    
                    <button type="button" class="btn-next" id="btnSendOtp" style="width: 100%;" disabled>Solve Captcha to Send OTP</button>
                </div>

                <div id="otpStep" style="display: none;">
                    <div class="form-group">
                        <label style="color: var(--success);">OTP sent successfully!</label>
                        <input type="text" id="otpCode" placeholder="Enter 6-digit OTP">
                    </div>
                    <button type="button" class="btn-next" id="btnSubmitFinal" style="width: 100%; background: var(--success);">Verify & Submit Vehicle</button>
                </div>
            </div>

            <div class="btn-row">
                <button type="button" class="btn-back" onclick="prevStep(4)">Back to Photos</button>
            </div>
        </div>
    </div>

    <!-- Success Screen -->
    <div class="success-screen" id="successScreen">
        <div class="check-circle">
            <svg viewBox="0 0 24 24"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/></svg>
        </div>
        <h2 style="color: var(--success);">Vehicle Submitted to Admin!</h2>
        <p style="color: var(--text-muted); margin-bottom: 25px;">Your vehicle is pending approval. We will contact you at your verified number shortly.</p>
        <a href="/"><button class="btn-back" style="width: 100%;">Return to Home</button></a>
    </div>
</div>

<!-- Standard UI Script -->
<script>
    function selectCategory(element, cat) {
        document.querySelectorAll('.opt-card').forEach(el => el.classList.remove('selected'));
        element.classList.add('selected');
        document.getElementById('sellCategory').value = cat;
    }

    function nextStep(current) {
        if(current === 1 && !document.getElementById('sellCategory').value) return alert("Select a category.");
        if(current === 2 && !document.getElementById('sellCondition').value) return alert("Select the condition.");
        
        if(current === 3) {
            // Trigger recaptcha initialization when moving to the final step
            if(window.initRecaptcha) window.initRecaptcha();
        }

        document.getElementById(`step-${current}`).classList.remove('active');
        document.getElementById(`step-${current + 1}`).classList.add('active');
        document.getElementById(`pb-${current + 1}`).classList.add('active');
    }

    function prevStep(current) {
        document.getElementById(`step-${current}`).classList.remove('active');
        document.getElementById(`step-${current - 1}`).classList.add('active');
        document.getElementById(`pb-${current}`).classList.remove('active');
    }

    let uploadedFiles = [];
    function handleFiles(input) {
        const files = Array.from(input.files);
        uploadedFiles = uploadedFiles.concat(files);
        updatePreview();
    }

    function updatePreview() {
        const container = document.getElementById('previewContainer');
        const status = document.getElementById('photoStatus');
        const nextBtn = document.getElementById('btnNextPhoto');
        
        container.innerHTML = '';
        uploadedFiles.forEach((file, index) => {
            const reader = new FileReader();
            reader.onload = (e) => {
                const img = document.createElement('img');
                img.src = e.target.result;
                img.className = 'img-preview';
                img.onclick = () => { uploadedFiles.splice(index, 1); updatePreview(); };
                container.appendChild(img);
            };
            reader.readAsDataURL(file);
        });

        status.innerText = `Minimum 5 photos required. Currently: ${uploadedFiles.length}`;
        
        if(uploadedFiles.length >= 5) {
            nextBtn.disabled = false;
            status.style.color = "var(--success)";
        } else {
            nextBtn.disabled = true;
            status.style.color = "var(--text-muted)";
        }
    }
</script>

<!-- Firebase Phone Auth & Database Submission Script -->
<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.4.0/firebase-app.js";
    import { getAuth, RecaptchaVerifier, signInWithPhoneNumber } from "https://www.gstatic.com/firebasejs/10.4.0/firebase-auth.js";

    const firebaseConfig = {
        apiKey: "AIzaSyBFgXHdimiKDSOZ8FtUvgBGzqLOmeVcY6o",
        authDomain: "shiva-motors-33ef4.firebaseapp.com",
        projectId: "shiva-motors-33ef4",
        storageBucket: "shiva-motors-33ef4.firebasestorage.app",
        messagingSenderId: "1001689773951",
        appId: "1:1001689773951:web:1f0ddad6f3bb6bf6894c4a"
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);

    // Bind initialization to window so the UI script can call it
    window.initRecaptcha = function() {
        if(!window.recaptchaVerifier) {
            window.recaptchaVerifier = new RecaptchaVerifier(auth, 'recaptcha-container', {
                'size': 'normal',
                'callback': (response) => {
                    const btn = document.getElementById('btnSendOtp');
                    btn.disabled = false;
                    btn.innerText = "Send OTP via SMS";
                },
                'expired-callback': () => {
                    document.getElementById('btnSendOtp').disabled = true;
                }
            });
            window.recaptchaVerifier.render();
        }
    }

    document.getElementById('btnSendOtp').addEventListener('click', () => {
        const phone = document.getElementById('phoneNumber').value;
        const price = document.getElementById('sellPrice').value;
        const btn = document.getElementById('btnSendOtp');
        
        if(!price || Number(price) <= 0) return alert("Enter your expected price first.");
        
        btn.innerText = "Sending Code...";
        btn.disabled = true;

        signInWithPhoneNumber(auth, phone, window.recaptchaVerifier)
            .then((confirmationResult) => {
                window.confirmationResult = confirmationResult;
                document.getElementById('phoneStep').style.display = 'none';
                document.getElementById('otpStep').style.display = 'block';
            }).catch((error) => {
                console.error(error);
                alert("Error sending OTP. Ensure the number is valid and includes +91.");
                window.recaptchaVerifier.render().then(widgetId => grecaptcha.reset(widgetId));
                btn.innerText = "Send OTP via SMS";
                btn.disabled = false;
            });
    });

    document.getElementById('btnSubmitFinal').addEventListener('click', () => {
        const code = document.getElementById('otpCode').value;
        const btn = document.getElementById('btnSubmitFinal');
        btn.innerText = "Verifying Identity...";
        btn.disabled = true;

        window.confirmationResult.confirm(code).then((result) => {
            // OTP is valid! Send the vehicle data to our MongoDB Backend
            submitToDatabase(result.user.phoneNumber);
        }).catch((error) => {
            alert("Invalid OTP code. Please check your SMS and try again.");
            btn.innerText = "Verify & Submit Vehicle";
            btn.disabled = false;
        });
    });

    function submitToDatabase(verifiedPhone) {
        const data = {
            category: document.getElementById('sellCategory').value,
            condition: document.getElementById('sellCondition').value,
            details: document.getElementById('sellDetails').value,
            price: document.getElementById('sellPrice').value,
            phone: verifiedPhone
        };

        fetch('/api/sell-vehicle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        }).then(res => res.json())
          .then(response => {
              document.getElementById('formContent').style.display = 'none';
              document.getElementById('successScreen').style.display = 'block';
          }).catch(err => alert("Error saving data to database."));
    }
</script>
</body>
</html>